function rgbToHex(value: string): string {
  const m = value.match(/rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/)
  if (!m) return value
  const toHex = (n: string) => Number(n).toString(16).padStart(2, '0')
  return `#${toHex(m[1])}${toHex(m[2])}${toHex(m[3])}`
}

function useResolvedColors(refs: React.RefObject<Record<string, HTMLDivElement | null>>): Record<string, string> {
  const [resolved, setResolved] = useState<Record<string, string>>({})

  useEffect(() => {
    const id = window.setTimeout(() => {
      const next: Record<string, string> = {}
      for (const [key, node] of Object.entries(refs.current ?? {})) {
        if (!node) continue
        const bg = getComputedStyle(node).backgroundColor
        next[key] = rgbToHex(bg)
      }
      setResolved(next)
    }, 0)
    return () => window.clearTimeout(id)
  })

  return resolved
}

function Swatch({
  label,
  varName,
  onResolveRef,
  small,
}: {
  label: string
  varName: string
  onResolveRef: (node: HTMLDivElement | null) => void
  small?: boolean
}) {
  return (
    <div className="flex flex-col gap-1.5">
      <div
        ref={onResolveRef}
        className={`w-full rounded-md border border-stroke-muted ${small ? 'h-12' : 'h-16'}`}
        style={{ backgroundColor: `var(${varName})` }}
        title={varName}
      />
      <div className="flex flex-col">
        <Text variant="body-xs" fontWeight="semibold" color="primary">
          {label}
        </Text>
        <Text variant="body-xs" fontFamily="mono" color="muted">
          {varName}
        </Text>
      </div>
    </div>
  )
}

function SectionHeader({ children }: { children: React.ReactNode }) {
