{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type-check @swift/components against its source, mirroring the Vite
       alias in vite.config.ts. This keeps `tsc -b` independent of the
       package's built `dist/*.d.ts`, which may be missing or stale on a
       fresh CI checkout (e.g. Vercel) and caused TS2307 across every subpath
       import. Both `tsc` AND Vite 8's rolldown bundler read these `paths`;
       the components entries point at real `.ts` source, so both resolve
       correctly. `@swift/icons` is intentionally NOT mapped: it is
       code-generated with no persistent source, so an alias could only point
       at a declaration file — which the bundler would then try to load as
       runtime code, causing MISSING_EXPORT for every icon. Icons resolve
       normally through the package `exports` map to their built `dist`,
       which the root build produces before the example builds. */
    "paths": {
      "@swift/components": ["../../packages/components/src/index.ts"],
      "@swift/components/*": ["../../packages/components/src/*/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
