      "import": "./dist/Tabs.js",
      "require": "./dist/Tabs.cjs"
    },
    "./Text": {
      "types": "./dist/src/Text/index.d.ts",
      "import": "./dist/Text.js",
      "require": "./dist/Text.cjs"
    },
    "./TimePicker": {
      "types": "./dist/src/TimePicker/index.d.ts",
      "import": "./dist/TimePicker.js",
