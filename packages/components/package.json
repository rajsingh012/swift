      "import": "./dist/Badge.js",
      "require": "./dist/Badge.cjs"
    },
    "./Button": {
      "types": "./dist/src/Button/index.d.ts",
      "import": "./dist/Button.js",
      "require": "./dist/Button.cjs"
    },
    "./Card": {
      "types": "./dist/src/Card/index.d.ts",
      "import": "./dist/Card.js",
      "require": "./dist/Card.cjs"
    },
    "./Carousel": {
      "types": "./dist/src/Carousel/index.d.ts",
      "import": "./dist/Carousel.js",
      "require": "./dist/Carousel.cjs"
