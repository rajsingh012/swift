{
  "name": "@swift/components",
  "version": "0.0.1",
  "description": "Swift component library — accessible React components.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./Accordion": {
      "types": "./dist/src/Accordion/index.d.ts",
      "import": "./dist/Accordion.js",
      "require": "./dist/Accordion.cjs"
    },
    "./Badge": {
      "types": "./dist/src/Badge/index.d.ts",
      "import": "./dist/Badge.js",
      "require": "./dist/Badge.cjs"
    },
    "./Button": {
      "types": "./dist/src/Button/index.d.ts",
      "import": "./dist/Button.js",
      "require": "./dist/Button.cjs"
    },
    "./Card": {
      "types": "./dist/src/Card/index.d.ts",
      "import": "./dist/Card.js",
      "require": "./dist/Card.cjs"
    },
    "./Checkbox": {
      "types": "./dist/src/Checkbox/index.d.ts",
      "import": "./dist/Checkbox.js",
      "require": "./dist/Checkbox.cjs"
    },
    "./Chip": {
      "types": "./dist/src/Chip/index.d.ts",
      "import": "./dist/Chip.js",
      "require": "./dist/Chip.cjs"
    },
    "./Input": {
      "types": "./dist/src/Input/index.d.ts",
      "import": "./dist/Input.js",
      "require": "./dist/Input.cjs"
    },
    "./ListItem": {
      "types": "./dist/src/ListItem/index.d.ts",
      "import": "./dist/ListItem.js",
      "require": "./dist/ListItem.cjs"
    },
    "./Radio": {
      "types": "./dist/src/Radio/index.d.ts",
      "import": "./dist/Radio.js",
      "require": "./dist/Radio.cjs"
    },
    "./Sheet": {
      "types": "./dist/src/Sheet/index.d.ts",
      "import": "./dist/Sheet.js",
      "require": "./dist/Sheet.cjs"
    },
    "./Text": {
      "types": "./dist/src/Text/index.d.ts",
      "import": "./dist/Text.js",
      "require": "./dist/Text.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme/index.css",
    "./theme/*": "./src/theme/*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "echo \"(no lint configured)\""
  },
  "peerDependencies": {
    "@swift/icons": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@swift/icons": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^4.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "swift",
    "library"
  ]
}
