{
  "name": "@swift/icons",
  "version": "0.0.1",
  "description": "Swift icon library — tree-shakeable React SVG icons.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./download": {
      "types": "./dist/utils/download.d.ts",
      "import": "./dist/utils/download.js",
      "require": "./dist/utils/download.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "node scripts/generate.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').rmSync('src_temp',{recursive:true,force:true})\"",
    "generate": "node scripts/generate.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.6",
    "svgo": "^4.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "icons",
    "svg",
    "swift",
    "ui"
  ]
}
